<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Edit your Google Tag Manager Configuration.'|trans({}, 'googletagmanager.bo.default') }}</h5>
    </div>
    <div class="card-body">
        {{ form_start(form, {action: path('admin_googletagmanager_configuration_save'), method: 'POST', attr: {id: 'googletagmanager-form', class: 'clearfix'}}) }}

        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.gtmId, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.gtmId, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.gtmId) }}
        </div>

        {{ form_rest(form) }}

        <button type="submit" name="googletagmanager_save" value="save" class="btn btn-primary btn-sm">
            {{ 'Save'|trans({}, 'googletagmanager.bo.default') }}
        </button>

        {{ form_end(form) }}
    </div>
</div>
